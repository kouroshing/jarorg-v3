# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# sqlite database — lives on the persistent disk (/app/data), never in git
# and never under public/, which is served to anyone.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
/data/

# android signing key and env dumps — must never be committed
signing.keystore
*.keystore
envs.txt

# typescript
*.tsbuildinfo
next-env.d.ts

# user uploads — runtime data on the Liara `uploads` persistent disk, not source.
# Keep the directory skeleton via .gitkeep so fresh clones have the paths.
/public/uploads/*
!/public/uploads/*/
/public/uploads/*/*
!/public/uploads/**/.gitkeep

# local browser profile used for debugging (80 MB)
/.chrome-user-data/

# build output and one-off archives
*.log
!npm-debug.log*
/project.zip
*.zip
