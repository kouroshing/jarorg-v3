# Site URL (used for sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://jarorg.ir"

# Database — SQLite on the `data` persistent disk (Liara: data → /app/data).
# Never point this under public/ — everything there is served without auth.
DATABASE_URL="file:../data/jar.db"

# Session JWT secret (min 16 chars; use 32+ random bytes in production)
AUTH_SECRET="change-me-to-a-long-random-string-in-production"

# Admin mobile (server-only). After OTP login, session role is "admin" for this number only.
ADMIN_MOBILE="09100138383"

# Optional: custom upload root (Liara: mount disk to public/uploads instead)
# UPLOAD_ROOT="/usr/src/app/public/uploads"

# IPPanel (FarazSMS)
IPPANEL_API_KEY=""
IPPANEL_SENDER_NUMBER="+983000505"

# Pattern codes (variables must match your IPPanel patterns)
IPPANEL_PATTERN_CUSTOMER=""
IPPANEL_PATTERN_ADMIN=""
ADMIN_NOTIF_PATTERN_CODE=""
IPPANEL_PATTERN_OTP=""

# Zarinpal Gateway config (Use "sandbox" for local testing, or your 36-char production Merchant ID)
ZARINPAL_MERCHANT_ID="sandbox"
