# Database — local SQLite (see prisma/schema.prisma provider)
DATABASE_URL="file:./dev.db"
# Production (cPanel MySQL): set provider to mysql in schema, then use:
# DATABASE_URL="mysql://CPANEL_DB_USER:CPANEL_DB_PASSWORD@localhost:3306/CPANEL_DB_NAME"

# Session JWT secret (min 16 chars; use 32+ random bytes in production)
AUTH_SECRET="change-me-to-a-long-random-string-in-production"

# Admin mobile (server-only). After OTP login, session role is "admin" for this number only.
ADMIN_MOBILE="09100138383"

# IPPanel (FarazSMS) — pattern SMS after new project submission
IPPANEL_API_KEY=""
IPPANEL_SENDER_NUMBER="+983000505"
# Pattern codes from IPPanel panel (variables must match your pattern: name, service, phone)
IPPANEL_PATTERN_CUSTOMER=""
# Admin new-lead notification (preferred; server-only read)
NEXT_PUBLIC_ADMIN_NOTIF_PATTERN_CODE=""
# Legacy fallback for admin notification
IPPANEL_PATTERN_ADMIN=""
# Login OTP pattern (message variable: %code%)
IPPANEL_PATTERN_OTP=""
