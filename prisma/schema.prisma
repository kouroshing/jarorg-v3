// Prisma schema for Jar.
// Use MySQL DATABASE_URL (local/prod) and run npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Platform user identified by mobile number.
model User {
  id          String   @id @default(uuid())
  phone       String   @unique
  displayName String?  @map("display_name")
  role        String   @default("USER")
  createdAt   DateTime @default(now()) @map("created_at")

  projects Project[]

  @@map("users")
}

/// Featured specialist shown on the site and assignable to projects.
model Expert {
  id          String   @id @default(uuid())
  name        String
  imageUrl    String   @map("image_url")
  description String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  projects Project[]

  @@map("experts")
}

/// One-time login code sent via SMS (upserted per phone).
model VerificationCode {
  phone     String   @id
  code      String
  expiresAt DateTime @map("expires_at")

  @@map("verification_codes")
}

/// Consultation / lead request submitted from the public form.
model Project {
  id                String   @id @default(uuid())
  createdAt         DateTime @default(now()) @map("created_at")
  serviceType       String   @map("service_type")
  city              String   @default("tehran")
  brief             String
  referenceLink     String?  @map("reference_link")
  serviceDetails    String?  @map("service_details")
  contactName       String?  @map("contact_name")
  contactPhone      String?  @map("contact_phone")
  preferredCallTime String?  @map("preferred_call_time")
  budget            String?
  adminNotes        String?  @map("admin_notes")
  bookingRoute      String   @default("meeting_request") @map("booking_route")
  status            String   @default("PENDING")
  financialModel    String   @default("45_45_10_split") @map("financial_model")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  expertId String? @map("expert_id")
  expert   Expert? @relation(fields: [expertId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("projects")
}
